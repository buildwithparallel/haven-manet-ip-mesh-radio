#!/bin/sh /etc/rc.common
# Parallel Toolchain SDR agent: RTL-SDR waterfall data on port 8090 for the SDR tab.
START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/haven-sdr -listen :8090
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
